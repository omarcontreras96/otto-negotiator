# --- ElevenLabs Agents (voice layer) ---
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_QUOTE_AGENT_ID=
ELEVENLABS_NEGO_AGENT_ID=
ELEVENLABS_REPORT_AGENT_ID=
# Optional: when set, post-call webhooks are HMAC-verified. Empty disables.
ELEVENLABS_WEBHOOK_SECRET=

# --- Reasoning -------------------------------------------------------------
# Two interchangeable backends. On Maritime, OPENAI_API_KEY + OPENAI_BASE_URL are
# injected automatically (their bundled proxy) and cost nothing extra — leave both
# blank here. Locally you need one of the two.
ANTHROPIC_API_KEY=
OTTO_MODEL=claude-sonnet-5
# Force a backend: anthropic | maritime. Empty = auto (Maritime proxy if present).
OTTO_LLM_BACKEND=

# --- Research (optional; a real SF seed list is used if unset) ---
GOOGLE_PLACES_API_KEY=

# --- Orchestrator ---
# Public HTTPS base for this service (Maritime public URL, or ngrok in dev)
BASE_URL=

# --- Demo safety -----------------------------------------------------------
# true = every outbound call is routed to a DEMO_TARGET; real dealer names kept.
# With DEMO_MODE=true and DEMO_TARGETS empty, Otto cannot dial anything at all.
DEMO_MODE=true
DEMO_TARGETS=
AUTO_ADVANCE=true
