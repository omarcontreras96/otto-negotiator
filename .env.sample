# --- ElevenLabs Agents (voice layer) ---
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_QUOTE_AGENT_ID=
ELEVENLABS_NEGO_AGENT_ID=
ELEVENLABS_REPORT_AGENT_ID=
# Optional: when set, post-call webhooks are HMAC-verified. Empty disables.
ELEVENLABS_WEBHOOK_SECRET=

# --- Reasoning ---
ANTHROPIC_API_KEY=
OTTO_MODEL=claude-sonnet-5

# --- Research (optional; a Van Ness seed list is used if unset) ---
GOOGLE_PLACES_API_KEY=

# --- Orchestrator ---
# Public HTTPS base for this service (Maritime public URL, or ngrok in dev)
BASE_URL=

# --- Demo safety ---
# true = every outbound call is routed to a DEMO_TARGET; real dealer names kept
DEMO_MODE=true
DEMO_TARGETS=
AUTO_ADVANCE=true
